# Copy to .env and fill in your values (do not commit .env)

# Root folder containing Flyway project directories (each with flyway.toml)
FLYWAY_ROOT=/path/to/your/flyway-projects

# Flyway CLI command (must be on PATH or full path to flyway)
FLYWAY_CLI=flyway

# Optional: comma-separated project folder names to run (default: all discovered)
# FLYWAY_PROJECTS=service-a-db,service-b-db

# Max repair/migrate/fix retry cycles per project
FLYWAY_MAX_RETRIES=3
